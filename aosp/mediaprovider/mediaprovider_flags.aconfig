}

flag {
    name: "enable_local_search_for_photopicker"
    is_exported: false
    namespace: "mediaprovider"
    description: "This flag enables local search for photopicker"
    bug: "477829610"
}

flag {
    name: "enable_cmp_improvements"
    is_exported: false
    namespace: "mediaprovider"
    description: "This flag pushes the missing CMP requirements to implement cloud media provider."
    bug: "478186126"
}

flag {
    name: "enable_mime_type_update_on_rename"
    is_exported: false
    namespace: "mediaprovider"
