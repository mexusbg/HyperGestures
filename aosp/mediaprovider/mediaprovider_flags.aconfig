}

flag {
    name: "enable_photopicker_ui_customization_params_usage"
    is_exported: false
    namespace: "mediaprovider"
    description: "Enables usage of ui customization params api in photopicker."
    bug: "467914970"
}

flag {
    name: "enable_photopicker_selection_params_api"
    is_exported: true
    namespace: "mediaprovider"
    description: "This flag exposes the APIs for applying constraints on selectable media items."
    bug: "467334899"
}

flag {
    name: "enable_photopicker_ui_customization_params_api"
    is_exported: true
    namespace: "mediaprovider"
    description: "This flag exposes the APIs for UI customization in the Photo Picker."
    bug: "462035251"
}

flag {
    name: "enable_photopicker_banner_redesign"
    is_exported: false
    namespace: "mediaprovider"
    description: "This flag enables the refactored photopicker banner design"
