<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the settings page's palette (light), HyperOS's About phone colours: a teal
     glow at the top left over deep indigo that fades to black, cards of translucent white and a
     periwinkle accent. HgSettingsTheme maps it onto Material 3's colour roles; hg_settings_bg
     layers the background. The status card is the same in both themes.
     -->
<resources>
    <color name="hg_settings_bg_top">#FFD9E6F7</color>
    <color name="hg_settings_bg_middle">#FFE6E3F8</color>
    <color name="hg_settings_bg_bottom">#FFF7F6FA</color>
    <color name="hg_settings_bg_glow">#FFC4E0EE</color>
    <color name="hg_settings_bg_glow_end">#00C4E0EE</color>
    <color name="hg_settings_bg_shade">#80E7DDF6</color>
    <color name="hg_settings_bg_shade_end">#00E7DDF6</color>
    <color name="hg_settings_card">#CCFFFFFF</color>
    <color name="hg_settings_dialog">#FFFAFAFF</color>
    <color name="hg_settings_on_surface">#FF15162B</color>
    <color name="hg_settings_on_surface_variant">#FF5E5C70</color>
    <color name="hg_settings_outline">#FFC9C8D8</color>
    <color name="hg_settings_primary">#FF4A57D6</color>
    <color name="hg_settings_on_primary">#FFFFFFFF</color>
    <color name="hg_settings_primary_container">#FFDFE2FF</color>
    <color name="hg_settings_on_primary_container">#FF10165E</color>
    <!-- The layout picker's miniatures (HgLayoutPreviewView): a dimmed screen, panes of
         translucent white with a fine edge, header bars; the unpicked tiles' ring -->
    <color name="hg_preview_screen">#14000000</color>
    <color name="hg_preview_card_base">#FFE4E2EE</color>
    <color name="hg_preview_card">#E6FFFFFF</color>
    <color name="hg_preview_card_stroke">#26000000</color>
    <color name="hg_preview_header">#40000000</color>
    <color name="hg_preview_ring">#1F000000</color>
    <!-- The status card (both themes): white text on the accent's blue to violet, darkened. -->
    <color name="hg_status_on_start">#FF2E5596</color>
    <color name="hg_status_on_center">#FF3A3F9E</color>
    <color name="hg_status_on_end">#FF4E3591</color>
    <color name="hg_status_standby_start">#FF3A3D5E</color>
    <color name="hg_status_standby_end">#FF2A2B45</color>
    <color name="hg_status_off_start">#FF85303F</color>
    <color name="hg_status_off_end">#FF4A2232</color>
    <color name="hg_status_text">#FFFFFFFF</color>
    <color name="hg_status_text_secondary">#FFE6E8FF</color>
    <!-- The version pill, the status list's panel and its dividers, over the card -->
    <color name="hg_status_pill">#29FFFFFF</color>
    <color name="hg_status_list">#1AFFFFFF</color>
    <color name="hg_status_divider">#1FFFFFFF</color>
    <!-- The status list's dots: OK, pending, failed, nothing to say (HgStatusCard levels) -->
    <color name="hg_status_ok">#FF9FF0C0</color>
    <color name="hg_status_pending">#FFFFD48A</color>
    <color name="hg_status_failed">#FFFF9E9E</color>
    <color name="hg_status_neutral">#FFB9B8CC</color>
</resources>
