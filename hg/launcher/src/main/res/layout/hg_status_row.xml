<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: one fact on the status card (HgStatusCardPreference): its label, then at the
     end a dot in the colour of its level and the value. The divider below is the card's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/hg_status_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/hg_status_text_secondary" />

    <View
        android:id="@+id/hg_status_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/hg_status_dot" />

    <TextView
        android:id="@+id/hg_status_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:maxWidth="200dp"
        android:gravity="end"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/hg_status_text" />
</LinearLayout>
