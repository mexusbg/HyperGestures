<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the mark of a settings row that opens a web page (HgSettingsFragment). Its
     description is part of what TalkBack reads for the row, so the row says it opens the
     browser. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:contentDescription="@string/hg_settings_opens_in_browser"
    android:src="@drawable/hg_ic_settings_open"
    android:tint="?android:attr/textColorSecondary" />
