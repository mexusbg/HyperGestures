<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the status card at the top of the settings page (HgSettingsFragment): icon,
     headline and note on the gradient of its kind (hg_status_*_bg), white in both themes.
     Preference binds the icon, title and summary by their ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="@dimen/hg_settings_row_padding">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:tint="@color/hg_status_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/hg_status_text" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/hg_status_text_secondary" />
    </LinearLayout>
</LinearLayout>
