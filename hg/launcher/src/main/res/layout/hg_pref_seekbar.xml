<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: a settings slider row (HgPreferenceTheme): as hg_pref_row, the slider under
     the text, its track lined up with the text (the negative margins give the thumb its room).
     SeekBarPreference binds the seekbar and its value by their ids; the value stays hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/hg_settings_row_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/hg_settings_row_padding"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="4"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary" />

    <SeekBar
        android:id="@id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="-14dp"
        android:layout_marginEnd="-14dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <TextView
        android:id="@id/seekbar_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
