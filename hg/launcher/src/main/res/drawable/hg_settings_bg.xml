<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the settings page's window background, as HyperOS's About phone: top to
     bottom from blue through deep indigo to black, a teal glow at the top left and a darker
     corner at the top right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.4"
                android:startColor="@color/hg_settings_bg_top"
                android:centerColor="@color/hg_settings_bg_middle"
                android:endColor="@color/hg_settings_bg_bottom"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="90%"
                android:startColor="@color/hg_settings_bg_glow"
                android:endColor="@color/hg_settings_bg_glow_end"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1"
                android:centerY="0"
                android:gradientRadius="80%"
                android:startColor="@color/hg_settings_bg_shade"
                android:endColor="@color/hg_settings_bg_shade_end"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
