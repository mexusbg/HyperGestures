<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the status card's background while ours run (HgSettingsFragment). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/hg_settings_card_radius" />
    <gradient
        android:angle="315"
        android:startColor="@color/hg_status_on_start"
        android:centerColor="@color/hg_status_on_center"
        android:endColor="@color/hg_status_on_end"
        android:type="linear" />
</shape>
