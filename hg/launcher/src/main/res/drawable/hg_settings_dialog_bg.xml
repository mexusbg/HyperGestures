<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the settings page's dialogs (a list's choices, HgSettingsDialog): a rounded
     card in the page's dialog colour, inset from the screen's edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp"
    android:insetTop="24dp"
    android:insetRight="24dp"
    android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/hg_settings_card_radius" />
        <solid android:color="@color/hg_settings_dialog" />
    </shape>
</inset>
