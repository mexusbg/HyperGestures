<?xml version="1.0" encoding="utf-8"?>
<!-- HyperGestures: the frosted round button of the MIUI-style recents (clear all, the card action
     buttons, the lock badge while swiping a card down). A view cannot blur what is behind it, so
     the frost is drawn: a translucent white disc with a light rim, over recents' blurred background
     (HgRecentsBlur). A white ripple shows the press. Without blur, hg_solid_circle instead
     (HgBlurSupport.followGlassCircle). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#52FFFFFF"
                android:endColor="#2EFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
